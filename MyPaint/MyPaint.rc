IDD_MYPAINT_DIALOG DIALOGEX 0, 0, 640, 400
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW | WS_EX_ACCEPTFILES
CAPTION "MyPaint"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
END

IDD_SIZE_DIALOG DIALOGEX 0, 0, 200, 96
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Size"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Width",IDC_SIZE_WIDTH_LABEL,12,14,60,8
    EDITTEXT        IDC_SIZE_WIDTH,80,12,70,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "px",IDC_STATIC,156,14,30,8
    LTEXT           "Height",IDC_SIZE_HEIGHT_LABEL,12,34,60,8
    EDITTEXT        IDC_SIZE_HEIGHT,80,32,70,14,ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "px",IDC_STATIC,156,34,30,8
    CONTROL         "Keep aspect ratio",IDC_SIZE_KEEP_RATIO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,54,176,10
    DEFPUSHBUTTON   "OK",IDOK,84,74,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,138,74,50,14
END

